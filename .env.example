# =============================================================================
# Docket Console — environment
# Copy these into Vercel: Settings → Environment Variables (all three scopes).
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------

# Signs the session tokens. Any long random string; 32+ characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Added for you automatically when you create a Postgres database under
# Vercel → Storage. Only set this by hand for local development.
POSTGRES_URL=

# ---- REMINDER EMAILS (optional; the console runs without them) ---------------

# Free API key from resend.com
RESEND_API_KEY=

# Must be on a domain verified in Resend.
MAIL_FROM=Docket <docket@revanzadevelopers.com>

# Where the "Open the console" button in those emails points.
APP_URL=https://your-project.vercel.app

# ---- OPTIONAL ---------------------------------------------------------------

# Minutes ahead of UTC; decides what counts as "today" for chasing updates.
# 330 = India Standard Time. Default is 330.
TZ_OFFSET_MIN=330

# Vercel sets this itself for scheduled runs. Only set it by hand if you want
# to call /api/cron/reminders from outside the app.
CRON_SECRET=
